# Template for the private .env file.
# Copy this file to ".env" on the Mac Mini and fill in the real values there.
# NEVER put real values in this file: it is uploaded to GitHub.
# (.env itself is listed in .gitignore, so it stays private.)

# --- WhatsApp (Meta Cloud API) ---
# From: Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Secret. Permanent token, created in task 1.1.
WHATSAPP_ACCESS_TOKEN=
# Secret. From: your app -> App settings -> Basic -> App secret. Used in task 1.1.
WHATSAPP_APP_SECRET=
# A password we invent ourselves for the webhook, in task 1.1.
WHATSAPP_VERIFY_TOKEN=
