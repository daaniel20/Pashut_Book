# Template for the private .env file.
# Copy this file to ".env" on the Mac Mini and fill in the real values there.
# NEVER put real values in this file: it is uploaded to GitHub.
# (.env itself is listed in .gitignore, so it stays private.)

# --- WhatsApp (Meta Cloud API) ---
# From: Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Secret. Permanent (never expires) system-user token. Guide 1.1, Step 3.
WHATSAPP_ACCESS_TOKEN=
# Secret. From: your app -> App settings -> Basic -> App secret. Guide 1.1, Step 4.
WHATSAPP_APP_SECRET=
# A password we invent ourselves for the webhook. Guide 1.1, Step 5.
WHATSAPP_VERIFY_TOKEN=

# --- Supabase (database and photo storage) ---
# Project "pashut-book" (Frankfurt). Not secret, but kept here with the rest.
SUPABASE_URL=https://jyfnxrktbpgklihastvc.supabase.co
# Secret. Starts with "sb_secret_". From: Supabase -> project -> Project Settings -> API Keys.
# It gives FULL access to all data and photos: only on the Mac, never in chat or on GitHub.
SUPABASE_SECRET_KEY=
